# Backend (FastAPI) settings
# Comma-separated list of origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite) settings
# Not required in local dev (Vite proxies /api to localhost:8000 by default,
# see frontend/vite.config.ts). Set this if you deploy the backend separately
# and want the frontend to call it directly instead of via a proxy.
VITE_API_BASE_URL=http://localhost:8000/api
